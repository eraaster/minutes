# https://console.groq.com/keys 에서 무료 발급 (카드 등록 불필요)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 사이트 접속 비밀번호. 비워두면 누구나 사용 가능 → 배포할 땐 꼭 설정 권장
APP_PASSWORD=

# (선택) 모델 변경. 둘 다 Hugging Face에 공개된 오픈소스 모델
# STT: whisper-large-v3 (정확도↑) / whisper-large-v3-turbo (속도↑)
GROQ_STT_MODEL=whisper-large-v3
# 회의록 작성 모델 (쉼표로 여러 개, 앞에서부터 사용)
# 앞 모델의 무료 한도가 차면 자동으로 다음 모델로 넘어감 (Groq는 모델별 한도가 따로 있음)
# 비워두면 기본값: openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3-32b, openai/gpt-oss-20b
GROQ_LLM_MODELS=
