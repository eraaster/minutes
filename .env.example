# https://console.groq.com/keys 에서 무료 발급 (카드 등록 불필요)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 사이트 접속 비밀번호. 비워두면 누구나 사용 가능 → 배포할 땐 꼭 설정 권장
APP_PASSWORD=

# (선택) 모델 변경. 둘 다 Hugging Face에 공개된 오픈소스 모델
# STT: whisper-large-v3 (정확도↑) / whisper-large-v3-turbo (속도↑)
GROQ_STT_MODEL=whisper-large-v3
# 요약: openai/gpt-oss-120b (Apache 2.0). Groq 콘솔에서 다른 모델 ID로 교체 가능
GROQ_LLM_MODEL=openai/gpt-oss-120b
